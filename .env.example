# Server runtime
NODE_ENV=development
PORT=5000

# Strict CORS allowlist (comma-separated origins, e.g. https://rentme.example.com)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Authentication & JWT (Optional: set 32+ char secret to persist sessions across restarts; falls back to an in-memory CSPRNG secret)
JWT_SECRET=
JWT_EXPIRE=7d

# Database (MongoDB Atlas or managed MongoDB URI)
MONGODB_URI=

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Cloudinary Storage Configuration (for room photos and profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
