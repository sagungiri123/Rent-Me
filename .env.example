# Server runtime
NODE_ENV=production
PORT=3000

# Strict CORS allowlist (comma-separated origins, e.g. https://rentme.example.com)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Authentication & JWT (REQUIRED in production: minimum 32 random bytes hex)
JWT_SECRET=
JWT_EXPIRE=7d

# Database (MongoDB Atlas or managed MongoDB URI)
MONGODB_URI=

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=