{
  "name": "rent-me",
  "version": "1.0.0",
  "description": "Student housing platform for Kathmandu Valley",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node server/server.js",
    "server": "npm run dev:server",
    "client": "npm run dev:client",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/server.js",
    "lint": "npm --prefix client run lint",
    "seed:server": "node server/utils/seed.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.77.0",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
